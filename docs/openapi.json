                }
              }
            }
          }
        }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "summary": "Wait for a simulated chat completion or stream its verified result",
        "x-acm-scope": "models:run",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Confirmed simulated completion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Completion"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "description": "Progressive chunks with acm_provisional=true are previews. A final finish_reason, optional usage, and [DONE] require a committed signed terminal result. A failed stream ends without [DONE]."
              }
            },
            "headers": {
              "X-ACM-Job-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Persistent local job identifier"
              }
            }
          },
          "default": {
            "description": "Structured refusal or current work status is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchemaError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/completions": {
      "post": {
        "summary": "Wait for a simulated text completion or stream its verified result",
        "x-acm-scope": "models:run",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompletionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Confirmed simulated completion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Completion"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "description": "Progressive chunks with acm_provisional=true are previews. A final finish_reason, optional usage, and [DONE] require a committed signed terminal result. A failed stream ends without [DONE]."
              }
            },
            "headers": {
              "X-ACM-Job-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Persistent local job identifier"
              }
            }
          },
          "default": {
            "description": "Structured refusal or current work status is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchemaError"
                }
              }
            }
          }
        }
      }
    },
    "/acm/v1/telemetry/challenge": {
      "post": {
