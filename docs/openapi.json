    "/acm/v1/dashboard": {
      "get": {
        "summary": "Read dashboard with named release gates",
        "x-acm-scope": "manage:read",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Dashboard projection",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "placement": {
                      "type": "object",
                      "description": "Read-only admission explanation only. Does not authorize work or reserve resources. Other modes are not evaluated.",
                      "required": ["kind", "status", "evaluatedAt", "selection", "nodes", "reservationPerformed", "dispatchPerformed"],
                      "properties": {
                        "kind": {"const": "READ_ONLY_ADMISSION"},
                        "status": {"enum": ["REJECTED", "NOT_EVALUATED"]},
                        "evaluatedAt": {"type": ["integer", "null"]},
                        "selection": {"type": ["array", "null"], "maxItems": 0},
                        "reservationPerformed": {"const": false},
                        "dispatchPerformed": {"const": false},
                        "nodes": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": ["nodeId", "eligible", "source", "status", "freshness", "executionQualification", "reasons"],
                            "properties": {
                              "nodeId": {"type": "string"},
                              "eligible": {"const": false},
                              "source": {"type": "string"},
                              "status": {"type": "string"},
                              "freshness": {"enum": ["FRESH", "STALE", "UNKNOWN"]},
                              "executionQualification": {"const": "NOT_EVALUATED"},
                              "reasons": {
                                "type": "array",
                                "minItems": 1,
                                "items": {"enum": ["READ_ONLY_MODE", "OBSERVATION_NOT_EXECUTION_QUALIFICATION", "TELEMETRY_STALE", "TELEMETRY_UNKNOWN", "NODE_OFFLINE"]}
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Structured refusal or current work status is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchemaError"
                }
              }
            }
          }
        }
      }
    },
    "/acm/v1/dashboard/history": {
