{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Compute Manager local API",
    "version": "1.0.0-preview.1",
    "description": "IPv4 loopback controller with real read-only observations and simulated execution. Privileged actions and production generation remain gated."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "SchemaError": {
        "type": "object",
        "required": [
          "error",
          "requestId"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Envelope": {
        "type": "object",
        "required": [
          "requestId",
          "data"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "data": {
            "type": "object"
          }
        }
      },
      "Usage": {
        "type": "object",
        "required": [
          "prompt_tokens",
          "completion_tokens",
          "total_tokens"
        ],
        "properties": {
          "prompt_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "completion_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "total_tokens": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ChatRequest": {
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "examples": [
              "fixture:demo"
            ]
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1
          },
          "stream": {
            "type": "boolean",
            "default": false
          },
          "stream_options": {
            "type": "object",
            "required": [
              "include_usage"
            ],
            "additionalProperties": false,
            "properties": {
              "include_usage": {
                "type": "boolean"
              }
            }
          },
          "max_completion_tokens": {
            "type": "integer",
            "minimum": 1
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "required": [
                "role",
                "content"
              ],
              "additionalProperties": false,
              "properties": {
                "role": {
                  "enum": [
                    "system",
                    "user",
                    "assistant"
                  ]
                },
                "content": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      },
      "CompletionRequest": {
        "type": "object",
        "required": [
          "model",
          "prompt"
        ],
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "examples": [
              "fixture:demo"
            ]
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1
          },
          "stream": {
            "type": "boolean",
            "default": false
          },
          "stream_options": {
            "type": "object",
            "required": [
              "include_usage"
            ],
            "additionalProperties": false,
            "properties": {
              "include_usage": {
                "type": "boolean"
              }
            }
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "JobRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "examples": [
              "fixture:demo"
            ]
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1
          },
          "input": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "integer",
            "minimum": -10,
            "maximum": 10,
            "default": 0
          }
        }
      },
      "Job": {
        "type": "object",
        "required": [
          "id",
          "model",
          "state",
          "canCancel"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "model": {
            "type": "string",
            "examples": [
              "fixture:demo"
            ]
          },
          "state": {
            "enum": [
              "QUEUED",
              "RUNNING",
              "STOPPING",
              "SUCCEEDED",
              "FAILED",
              "CANCELLED",
              "INTERRUPTED"
            ]
          },
          "source": {
            "const": "SIMULATION"
          },
          "nodeId": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "integer"
          },
          "attemptId": {
            "type": [
              "string",
              "null"
            ]
          },
          "durationMs": {
            "type": [
              "integer",
              "null"
            ]
          },
          "usage": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Usage"
              },
              {
                "type": "null"
              }
            ]
          },
          "decision": {
            "type": [
              "object",
              "null"
            ]
          },
          "cleanup": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "confirmed": {
                "type": "boolean"
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "error": {
            "type": [
              "object",
              "null"
            ]
          },
          "canCancel": {
            "type": "boolean"
          },
          "output": {
            "type": "string",
            "description": "Confirmed success. Returned only to the authorized owner."
          }
        }
      },
      "Completion": {
        "type": "object",
        "required": [
          "id",
          "created",
          "object",
          "model",
          "choices",
          "usage",
          "acm_source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "created": {
            "type": "integer"
          },
          "object": {
            "enum": [
              "chat.completion",
              "text_completion"
            ]
          },
          "model": {
            "type": "string",
            "examples": [
              "fixture:demo"
            ]
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          },
          "acm_source": {
            "const": "SIMULATION"
          }
        }
      },
      "Challenge": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nodeId"
        ],
        "properties": {
          "nodeId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          }
        }
      },
      "ObservationEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nodeId",
          "snapshot"
        ],
        "properties": {
          "nodeId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "snapshot": {
            "type": "object",
            "description": "One Agent or authorized relay envelope, Ed25519 signed over the canonical payload.",
            "required": [
              "payload",
              "signature"
            ],
            "additionalProperties": false,
            "properties": {
              "payload": {
                "type": "object"
              },
              "signature": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{86}$"
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/acm/v1/health": {
      "get": {
        "summary": "Get local API health and data source",
        "x-acm-scope": "manage:read",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Valid response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "default": {
            "description": "Structured refusal or current work status is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchemaError"
                }
              }
            }
          }
        }
      }
    },
