        },
        "responses": {
          "200": {
            "description": "Challenge or verified observation receipt",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Rejected input, authorization, freshness or replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchemaError"
                }
              }
            }
          }
        }
      }
    }
  }
